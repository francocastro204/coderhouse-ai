# Plantilla de configuración. Este archivo sí se sube a GitHub.
# No pongas keys reales acá.
#
# Para usarlo: copiar este archivo a .env y completar solo las claves
# del proveedor que vayas a probar. .env no se sube (está en .gitignore).
# main.py lee esas variables al arrancar.
#
# LLM_PROVIDER elige quién responde: openai | anthropic | gemini | huggingface

LLM_PROVIDER=gemini

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY autoriza la llamada. OPENAI_MODEL es el modelo concreto.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Google Gemini (AI Studio, cupo gratis) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Hugging Face — https://huggingface.co/settings/tokens
# HF_TOKEN autoriza la Inference API. HF_MODEL es el id del modelo en el Hub,
# no el nombre de la plataforma.
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
