# Plantilla de configuración. Este archivo sí se sube a GitHub.
# No pongas keys reales acá.
#
# Para usarlo: copiar este archivo a .env y completar solo las claves
# del proveedor que vayas a probar. .env no se sube (está en .gitignore).
# main.py lee esas variables al arrancar.
#
# LLM_PROVIDER elige quién responde: openai | anthropic | gemini | huggingface

LLM_PROVIDER=gemini

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY autoriza la llamada. OPENAI_MODEL es el modelo concreto.
# Vacía a propósito: la API se cobra aparte. La unidad 2 usa Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude) — https://console.anthropic.com/
# ANTHROPIC_API_KEY también queda vacía. El plan de Claude.ai no cubre esta API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Google Gemini (AI Studio, cupo gratis) — https://aistudio.google.com/apikey
# GOOGLE_API_KEY es un alias. Si está vacío, el código usa GEMINI_API_KEY.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Hugging Face — https://huggingface.co/settings/tokens
# HF_TOKEN autoriza la Inference API. HF_MODEL es el id del modelo en el Hub,
# no el nombre de la plataforma.
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Pinecone (pre-entrega 4) — https://app.pinecone.io
# El índice es Serverless y el plan gratis alcanza. La key no se sube.
# OPENAI_API_KEY sigue vacía: los embeddings son de Gemini, en 1536 dimensiones.
PINECONE_API_KEY=
INDEX_NAME=coderhouse-unidad-4
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=biblioteca
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=1536
